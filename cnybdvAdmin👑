-- ================= ระบบ Anti-Fling =================
local antiFlingConnection = nil
local function toggleAntiFling(state)
    antiFlingMode = state
    if antiFlingMode then
        antiFlingConnection = RunService.Stepped:Connect(function()
            if not antiFlingMode then return end
            pcall(function()
                for _, plr in pairs(Players:GetPlayers()) do
                    if plr ~= LocalPlayer and plr.Character then
                        for _, part in pairs(plr.Character:GetChildren()) do
                            if part:IsA("BasePart") then part.CanCollide = false end
                        end
                    end
                end
                
                local char = LocalPlayer.Character
                if char then
                    local hrp = char:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        if hrp.AssemblyLinearVelocity.Magnitude > 250 then hrp.AssemblyLinearVelocity = Vector3.zero end
                        if hrp.AssemblyAngularVelocity.Magnitude > 250 then hrp.AssemblyAngularVelocity = Vector3.zero end
                    end
                end
            end)
        end)
    else
        if antiFlingConnection then
            antiFlingConnection:Disconnect()
            antiFlingConnection = nil
        end
    end
end

-- ================= ระบบ ESP & Name ESP =================
local function applyESP(plr)
    if plr == LocalPlayer then return end

    local function setupESP(char)
        if not char then return end

        if espMode and not char:FindFirstChild("CnybdvHighlight") then
            local highlight = Instance.new("Highlight")
            highlight.Name = "CnybdvHighlight"
            highlight.Parent = char
            highlight.Adornee = char
            highlight.FillColor = Color3.fromRGB(255, 0, 100)
            highlight.FillTransparency = 0.5
            highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
            highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        end

        local head = char:WaitForChild("Head", 3)
        if head and nameEspMode and not head:FindFirstChild("CnybdvNameTag") then
            local bbGui = Instance.new("BillboardGui")
            bbGui.Name = "CnybdvNameTag"
            bbGui.Parent = head
            bbGui.Adornee = head
            bbGui.Size = UDim2.new(0, 200, 0, 50)
            bbGui.StudsOffset = Vector3.new(0, 2.5, 0)
            bbGui.AlwaysOnTop = true

            local textLabel = Instance.new("TextLabel")
            textLabel.Parent = bbGui
            textLabel.BackgroundTransparency = 1
            textLabel.Size = UDim2.new(1, 0, 1, 0)
            textLabel.Font = Enum.Font.GothamBold
            textLabel.TextColor3 = Color3.fromRGB(0, 255, 200)
            textLabel.TextStrokeTransparency = 0
            textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
            textLabel.TextSize = 13

            task.spawn(function()
                while nameEspMode and bbGui and bbGui.Parent and char and char:FindFirstChild("HumanoidRootPart") do
                    pcall(function()
                        local myChar = LocalPlayer.Character
                        if myChar and myChar:FindFirstChild("HumanoidRootPart") then
                            local dist = math.floor((myChar.HumanoidRootPart.Position - char.HumanoidRootPart.Position).Magnitude)
                            textLabel.Text = string.format("%s\n(@%s) [%dm]", plr.DisplayName, plr.Name, dist)
                        end
                    end)
                    task.wait(0.2)
                end
            end)
        end
    end

    if plr.Character then setupESP(plr.Character) end
    plr.CharacterAdded:Connect(function(char)
        task.wait(0.5)
        setupESP(char)
    end)
end

local function toggleESP(state)
    espMode = state
    if espMode then
        for _, plr in pairs(Players:GetPlayers()) do applyESP(plr) end
    else
        for _, plr in pairs(Players:GetPlayers()) do
            if plr.Character and plr.Character:FindFirstChild("CnybdvHighlight") then
                plr.Character.CnybdvHighlight:Destroy()
