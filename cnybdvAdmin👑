-- ================= ระบบ Astral Projection =================
local astralPos, pitch, yaw = Vector3.zero, 0, 0
local rotateTouchObject, lastTouchPos = nil, Vector2.zero

UserInputService.InputBegan:Connect(function(input, processed)
    if not astralMode or processed then return end
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.MouseButton2 then
        if input ~= joystickTouchObject then
            rotateTouchObject = input
            lastTouchPos = input.Position
        end
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not astralMode then return end
    if input == rotateTouchObject or (UserInputService:IsMouseButtonPressed(Enum.MouseButton2) and input.UserInputType == Enum.MouseMovement) then
        local delta = input.Position - lastTouchPos
        lastTouchPos = input.Position
        yaw = yaw - delta.X * 0.005
        pitch = math.clamp(pitch - delta.Y * 0.005, math.rad(-89), math.rad(89))
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input == rotateTouchObject then rotateTouchObject = nil end
end)

local function toggleAstralProjection(state)
    astralMode = state
    toggleControlsVisibility()
    
    local char = LocalPlayer.Character
    if not char then return end
    local hum, hrp, cam = char:FindFirstChildOfClass("Humanoid"), char:FindFirstChild("HumanoidRootPart"), Workspace.CurrentCamera

    if astralMode then
        if hrp then
            hrp.Anchored = true
            astralPos = hrp.Position + Vector3.new(0, 3, 0)
            local _, y, _ = cam.CFrame:ToOrientation()
            yaw = y pitch = 0
        end
        cam.CameraType = Enum.CameraType.Scriptable

        task.spawn(function()
            while astralMode do
                local rotation = CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)
                local forward, right, up = rotation.LookVector * (-moveVector.Y), rotation.RightVector * (moveVector.X), Vector3.new(0, verticalDirection, 0)
                local deltaMove = forward + right + up
                if deltaMove.Magnitude > 1 then deltaMove = deltaMove.Unit end

                astralPos = astralPos + (deltaMove * (flySpeedValue / 50))
                cam.CFrame = CFrame.new(astralPos) * rotation
                RunService.RenderStepped:Wait()
            end

            if hrp then
                hrp.Anchored = false
                hrp.CFrame = CFrame.new(astralPos)
                hrp.AssemblyLinearVelocity = Vector3.zero
            end
            cam.CameraType = Enum.CameraType.Custom
            if hum then cam.CameraSubject = hum end
        end)
    end
end

-- ระบบบินปกติ
local function toggleFly(state)
    flying = state
    toggleControlsVisibility()

    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp, hum = char.HumanoidRootPart, char:FindFirstChildOfClass("Humanoid")

    if flying then
        hum.PlatformStand = true
        local bg = Instance.new("BodyGyro", hrp) bg.P = 9e4 bg.maxTorque = Vector3.new(9e9, 9e9, 9e9) bg.cframe = hrp.CFrame
        local bv = Instance.new("BodyVelocity", hrp) bv.velocity = Vector3.zero bv.maxForce = Vector3.new(9e9, 9e9, 9e9)

        task.spawn(function()
            while flying and char and hrp and hrp.Parent do
                local cam = Workspace.CurrentCamera
                local forward, right, up = cam.CFrame.LookVector * (-moveVector.Y), cam.CFrame.RightVector * (moveVector.X), Vector3.new(0, verticalDirection, 0)
                local finalVel = forward + right + up
                if finalVel.Magnitude > 1 then finalVel = finalVel.Unit end

                bg.cframe = cam.CFrame
                bv.velocity = finalVel * flySpeedValue
                RunService.RenderStepped:Wait()
            end
            if bg then bg:Destroy() end
            if bv then bv:Destroy() end
            if hum then hum.PlatformStand = false end
        end)
    end
end

