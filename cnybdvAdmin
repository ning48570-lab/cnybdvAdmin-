local function createTab(id, text)
    local tabBtn = Instance.new("TextButton")
    tabBtn.Name = "Tab_" .. id
    tabBtn.Parent = SideBar
    tabBtn.BackgroundColor3 = Color3.fromRGB(28, 28, 32)
    tabBtn.Size = UDim2.new(1, 0, 0, 36)
    tabBtn.Font = Enum.Font.GothamBold
    tabBtn.Text = text
    tabBtn.TextColor3 = Color3.fromRGB(150, 150, 150)
    tabBtn.TextSize = 11
    tabBtn.TextXAlignment = Enum.TextXAlignment.Left

    local tabPadding = Instance.new("UIPadding")
    tabPadding.PaddingLeft = UDim.new(0, 8)
    tabPadding.Parent = tabBtn

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = tabBtn

    local page = Instance.new("ScrollingFrame")
    page.Name = "Page_" .. id
    page.Parent = PageContainer
    page.BackgroundTransparency = 1
    page.Size = UDim2.new(1, 0, 1, 0)
    page.Visible = false
    page.ScrollBarThickness = 3
    page.CanvasSize = UDim2.new(0, 0, 0, 0)

    local pageLayout = Instance.new("UIListLayout")
    pageLayout.Parent = page
    pageLayout.SortOrder = Enum.SortOrder.LayoutOrder
    pageLayout.Padding = UDim.new(0, 8)

    pageLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        page.CanvasSize = UDim2.new(0, 0, 0, pageLayout.AbsoluteContentSize.Y + 10)
    end)

    tabs[id] = tabBtn
    pages[id] = page

    tabBtn.MouseButton1Click:Connect(function()
        for tId, tBtn in pairs(tabs) do
            tBtn.BackgroundColor3 = Color3.fromRGB(28, 28, 32)
            tBtn.TextColor3 = Color3.fromRGB(150, 150, 150)
        end
        for pId, pFrame in pairs(pages) do
            pFrame.Visible = false
        end

        tabBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
        tabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        page.Visible = true
    end)

    return page
end

