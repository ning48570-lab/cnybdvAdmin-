    local function refreshConfigList()
        for _, child in pairs(dropList:GetChildren()) do if child:IsA("TextButton") then child:Destroy() end end
        local count = 0
        ensureFolder()

        pcall(function()
            local files = safeListfiles(CONFIG_FOLDER)
            for _, filePath in pairs(files) do
                local fileName = filePath:gsub(CONFIG_FOLDER .. "/", ""):gsub(CONFIG_FOLDER .. "\\", "")
                if fileName:sub(-5) == ".json" then
                    local cleanName = fileName:sub(1, -6)
                    count = count + 1
                    local fBtn = Instance.new("TextButton")
                    fBtn.Parent = dropList fBtn.BackgroundColor3 = Color3.fromRGB(32, 32, 36) fBtn.Size = UDim2.new(1, 0, 0, 25)
                    fBtn.Font = Enum.Font.Gotham fBtn.Text = cleanName fBtn.TextColor3 = Color3.fromRGB(220, 220, 220) fBtn.TextSize = 11 fBtn.ZIndex = 16
                    fBtn.MouseButton1Click:Connect(function()
                        selectedConfigFile = cleanName
                        listBtn.Text = "เลือกอยู่: " .. cleanName
                        nameBox.Text = cleanName
                        dropList.Visible = false
                    end)
                end
            end
        end)
        dropList.CanvasSize = UDim2.new(0, 0, 0, count * 25)
    end

    listBtn.MouseButton1Click:Connect(function()
        dropList.Visible = not dropList.Visible
        if dropList.Visible then refreshConfigList() end
    end)

