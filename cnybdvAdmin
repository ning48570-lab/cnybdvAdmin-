    local hitBox = Instance.new("TextButton")
    hitBox.Parent = sliderTrack
    hitBox.BackgroundTransparency = 1
    hitBox.Position = UDim2.new(0, 0, 0, -10)
    hitBox.Size = UDim2.new(1, 0, 1, 20)
    hitBox.Text = ""

    local dragging = false
    local dragInput = nil

    local function updateSlider(input)
        local posX = input.Position.X - sliderTrack.AbsolutePosition.X
        local pos = math.clamp(posX / sliderTrack.AbsoluteSize.X, 0, 1)
        local val = math.floor(minVal + (maxVal - minVal) * pos)
        
        sliderFill.Size = UDim2.new(pos, 0, 1, 0)
        valueLabel.Text = tostring(val)
        
        task.spawn(function()
            callback(val)
        end)
    end

    local function setValue(val)
        val = math.clamp(val, minVal, maxVal)
        local pos = (val - minVal) / (maxVal - minVal)
        sliderFill.Size = UDim2.new(pos, 0, 1, 0)
        valueLabel.Text = tostring(val)
        callback(val)
    end

    hitBox.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragInput = input
            updateSlider(input)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input == dragInput or input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            updateSlider(input)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input == dragInput or input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
            dragInput = nil
        end
    end)

    if id then
        uiControls[id] = { SetValue = setValue }
    end
end

