-- ================= ระบบ Bring Unanchored Parts =================
local function toggleBringParts(state)
    bringPartsMode = state
    if bringPartsMode then
        task.spawn(function()
            while bringPartsMode do
                pcall(function()
                    local myChar = LocalPlayer.Character
                    if myChar and myChar:FindFirstChild("HumanoidRootPart") then
                        local myPos = myChar.HumanoidRootPart.Position
                        for _, part in pairs(Workspace:GetDescendants()) do
                            if part:IsA("BasePart") and not part.Anchored and not part:IsDescendantOf(myChar) then
                                if not part:FindFirstChildOfClass("BodyPosition") then
                                    part.CanCollide = false
                                    part.CFrame = CFrame.new(myPos + Vector3.new(math.random(-5, 5), 2, math.random(-5, 5)))
                                    part.AssemblyLinearVelocity = Vector3.zero
                                end
                            end
                        end
                    end
                end)
                task.wait(0.1)
            end
        end)
    end
end

