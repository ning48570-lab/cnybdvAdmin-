local CONFIG_FOLDER = "CnybdvHubConfigs"

local function ensureFolder()
    pcall(function()
        if safeIsfolder and not safeIsfolder(CONFIG_FOLDER) then
            safeMakefolder(CONFIG_FOLDER)
        end
    end)
end

local function applySettings(data)
    if not data then return end
    
    if data.speedValue and uiControls.Speed then uiControls.Speed.SetValue(data.speedValue) end
    if data.jumpValue and uiControls.Jump then uiControls.Jump.SetValue(data.jumpValue) end
    if data.flySpeedValue and uiControls.FlySpeed then uiControls.FlySpeed.SetValue(data.flySpeedValue) end
    if data.fovValue and uiControls.FOV then uiControls.FOV.SetValue(data.fovValue) end

    if data.autoM1Mode ~= nil and uiControls.AutoM1 then uiControls.AutoM1.SetState(data.autoM1Mode) end
    if data.infJumpMode ~= nil and uiControls.InfJump then uiControls.InfJump.SetState(data.infJumpMode) end
    if data.clickTpMode ~= nil and uiControls.ClickTP then uiControls.ClickTP.SetState(data.clickTpMode) end
    if data.flying ~= nil and uiControls.Fly then uiControls.Fly.SetState(data.flying) end
    if data.noclip ~= nil and uiControls.Noclip then uiControls.Noclip.SetState(data.noclip) end
    if data.astralMode ~= nil and uiControls.Astral then uiControls.Astral.SetState(data.astralMode) end
    if data.spinbotMode ~= nil and uiControls.Spinbot then uiControls.Spinbot.SetState(data.spinbotMode) end

    if data.antiFlingMode ~= nil and uiControls.AntiFling then uiControls.AntiFling.SetState(data.antiFlingMode) end
    if data.antiKnockbackMode ~= nil and uiControls.AntiKnockback then uiControls.AntiKnockback.SetState(data.antiKnockbackMode) end
    if data.espMode ~= nil and uiControls.ESP then uiControls.ESP.SetState(data.espMode) end
    if data.nameEspMode ~= nil and uiControls.NameESP then uiControls.NameESP.SetState(data.nameEspMode) end
    if data.boxEspMode ~= nil and uiControls.BoxESP then uiControls.BoxESP.SetState(data.boxEspMode) end
    if data.tracerEspMode ~= nil and uiControls.TracerESP then uiControls.TracerESP.SetState(data.tracerEspMode) end
    if data.fullbrightMode ~= nil and uiControls.Fullbright then uiControls.Fullbright.SetState(data.fullbrightMode) end

    if data.loopNearestBehindMode ~= nil and uiControls.LoopNearest then uiControls.LoopNearest.SetState(data.loopNearestBehindMode) end
    if data.bringPartsMode ~= nil and uiControls.BringParts then uiControls.BringParts.SetState(data.bringPartsMode) end
    if data.invisMode ~= nil and uiControls.Invisible then uiControls.Invisible.SetState(data.invisMode) end

    if data.Waypoints then
        for i = 1, 8 do
            local wpData = data.Waypoints[tostring(i)] or data.Waypoints[i]
            if wpData then
                waypoints[i] = CFrame.new(wpData[1], wpData[2], wpData[3], wpData[4], wpData[5], wpData[6], wpData[7], wpData[8], wpData[9], wpData[10], wpData[11], wpData[12])
                if waypointsLabels[i] then
                    waypointsLabels[i].Text = string.format("หมุดที่ %d: (%.0f, %.0f, %.0f)", i, wpData[1], wpData[2], wpData[3])
                    waypointsLabels[i].TextColor3 = Color3.fromRGB(0, 255, 200)
                end
            else
                waypoints[i] = nil
                if waypointsLabels[i] then
                    waypointsLabels[i].Text = "หมุดที่ " .. i .. ": [ว่าง]"
                    waypointsLabels[i].TextColor3 = Color3.fromRGB(180, 180, 180)
                end
            end
        end
    end
end

local function resetAllSettings()
    applySettings(DEFAULT_SETTINGS)
    waypoints = {}
    for i = 1, 8 do
        if waypointsLabels[i] then
            waypointsLabels[i].Text = "หมุดที่ " .. i .. ": [ว่าง]"
            waypointsLabels[i].TextColor3 = Color3.fromRGB(180, 180, 180)
        end
    end
end

