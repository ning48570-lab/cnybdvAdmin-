            saveBtn.Text = "❌ ใส่ชื่อ!"
            task.delay(1, function() saveBtn.Text = "💾 เซฟ" end)
            return
        end

        ensureFolder()

        local configData = {
            speedValue = speedValue,
            jumpValue = jumpValue,
            flySpeedValue = flySpeedValue,
            fovValue = fovValue,
            autoM1Mode = autoM1Mode,
            infJumpMode = infJumpMode,
            clickTpMode = clickTpMode,
            flying = flying,
            noclip = noclip,
            astralMode = astralMode,
            spinbotMode = spinbotMode,
            antiFlingMode = antiFlingMode,
            antiKnockbackMode = antiKnockbackMode,
            espMode = espMode,
            nameEspMode = nameEspMode,
            boxEspMode = boxEspMode,
            tracerEspMode = tracerEspMode,
            fullbrightMode = fullbrightMode,
            loopNearestBehindMode = loopNearestBehindMode,
            bringPartsMode = bringPartsMode,
            invisMode = invisMode,
            Waypoints = {}
        }

        for i = 1, 8 do
            if waypoints[i] then
                local components = {waypoints[i]:GetComponents()}
                configData.Waypoints[tostring(i)] = components
            end
        end

        pcall(function()
            local json = HttpService:JSONEncode(configData)
            safeWritefile(CONFIG_FOLDER .. "/" .. saveName .. ".json", json)
            saveBtn.Text = "✅ บันทึกแล้ว"
            selectedConfigFile = saveName
            listBtn.Text = "เลือกอยู่: " .. saveName
            task.delay(1, function() saveBtn.Text = "💾 เซฟ" end)
        end)
    end)

    loadBtn.MouseButton1Click:Connect(function()
        if not selectedConfigFile then
            loadBtn.Text = "❌ เลือกไฟล์ก่อน"
            task.delay(1, function() loadBtn.Text = "📂 โหลดค่า" end)
            return
        end

        pcall(function()
            local path = CONFIG_FOLDER .. "/" .. selectedConfigFile .. ".json"
            if safeIsfile(path) then
                local content = safeReadfile(path)
                local data = HttpService:JSONDecode(content)
                applySettings(data)
                loadBtn.Text = "✅ โหลดสำเร็จ"
                task.delay(1, function() loadBtn.Text = "📂 โหลดค่า" end)
            else
                loadBtn.Text = "❌ ไม่พบไฟล์"
            end
        end)
    end)

